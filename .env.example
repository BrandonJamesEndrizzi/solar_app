# Copy this file to .env and fill in your own credentials.
# .env is gitignored and must never be committed.

# The mailbox the report is sent from. For Gmail or iCloud, use an
# app-specific password, not your account password.
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=your-app-specific-password

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# https://developer.nytimes.com/  (Article Search API)
NYT_API_KEY=your-nyt-api-key

# https://www.ncdc.noaa.gov/cdo-web/token  (only needed for weather.py)
NOAA_CDO_TOKEN=your-noaa-cdo-token
